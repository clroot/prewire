{
  "name": "prewire",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "bun run format:check && bun run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
