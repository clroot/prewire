{
  "name": "@example/support",
  "private": true,
  "version": "0.0.0",
  "description": "react-router app of the example product line — third framework binding of the same router port, built with @prewire/vite",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "typecheck": "prewire codegen && tsc --noEmit"
  },
  "imports": {
    "#prewire": {
      "default": "./src/prewire/container.live.gen.ts"
    }
  },
  "dependencies": {
    "@example/kit": "workspace:*",
    "@prewire/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@prewire/cli": "workspace:*",
    "@prewire/vite": "workspace:*",
    "vite": "^7.0.0"
  }
}
