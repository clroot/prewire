    "@prewire/core": "workspace:*",
    "@tanstack/react-router": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@prewire/cli": "workspace:*",
    "vitest": "^4.1.10"
  }
}
