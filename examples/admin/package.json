{
  "name": "@example/admin",
  "private": true,
  "version": "0.0.0",
  "description": "TanStack Start app of the example product line — overrides the kit billing stub with a real implementation",
  "type": "module",
  "scripts": {
    "build": "prewire codegen && tsc --noEmit",
    "typecheck": "prewire codegen && tsc --noEmit",
