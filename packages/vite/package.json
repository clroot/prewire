{
  "name": "@prewire/vite",
  "version": "0.0.0",
  "description": "prewire build integration for Vite/webpack/rspack (unplugin) — runs codegen and wires the #prewire alias automatically",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prewire/cli": "workspace:^",
    "unplugin": "^2.0.0"
  },
  "devDependencies": {
    "@prewire/core": "workspace:*",
    "@types/node": "^26.1.2",
    "vite": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
