{
  "name": "@prewire/cli",
  "version": "0.0.0",
  "description": "prewire codegen CLI — scans injectable() declarations and generates per-app composition roots at build time",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prewire": "./bin/prewire.js"
  },
  "exports": {
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prewire/core": "workspace:^",
    "citty": "^0.2.2",
    "ts-morph": "^28.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
