{
  "name": "@prewire/cli",
  "version": "0.0.0",
  "description": "prewire codegen CLI — scans @Injectable classes and generates container wiring at build time",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prewire": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prewire/core": "workspace:*",
    "citty": "^0.2.2",
    "ts-morph": "^28.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
